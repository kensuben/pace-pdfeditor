# Cấu hình production cho PACE PDF Editor
# Sao chép file này thành deploy/.env.production trên VPS

# Microsoft Entra ID Authentication
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Directory (tenant) ID của PACE — không dùng common/organizations
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Danh sách email admin bootstrap (phân tách bằng dấu phẩy)
ADMIN_EMAILS=admin.test@example.com

# Cổng và địa chỉ IP lắng nghe trên VPS (phía sau reverse proxy)
# - Proxy chạy trên chính VPS: giữ APP_BIND=127.0.0.1
# - Proxy chạy ở máy khác trong LAN: APP_BIND=<IP LAN của VPS>, APP_PORT=<Forward Port trên proxy>
#   (để 127.0.0.1 trong trường hợp này sẽ gây lỗi 502 Bad Gateway)
APP_PORT=8080
APP_BIND=127.0.0.1

# Số lượng log tối đa lưu trong store.json trước khi xoay vòng sang logs-archive-YYYY-MM.jsonl (mặc định 20000, tối thiểu 1000)
LOG_MAX_IN_STORE=20000

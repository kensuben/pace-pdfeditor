# Cấu hình production cho PACE PDF Editor
# Sao chép file này thành deploy/.env.production trên VPS

# Microsoft Entra ID Authentication
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=common

# Danh sách email admin bootstrap (phân tách bằng dấu phẩy)
ADMIN_EMAILS=admin.test@example.com

# Cổng và địa chỉ IP lắng nghe trên VPS (phía sau reverse proxy)
APP_PORT=8080
APP_BIND=127.0.0.1

# Register a Single-page application in Microsoft Entra admin center.
# Add http://localhost:5173/redirect.html as a SPA redirect URI.
VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID dạng GUID của PACE — không dùng common
VITE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Biến xác thực cho backend API khi chạy compose.yaml (thường bằng giá trị VITE_* tương ứng)
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional digital-signature gateways. Endpoints must implement POST /v1/pdf/sign.
# Prefer a same-origin reverse proxy such as /signing-api for remote signing.
VITE_SIGNING_API_URL=
VITE_USB_SIGNING_AGENT_URL=
ADMIN_EMAILS=admin.test@example.com
